<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 3.4.x 父 POM：统一管理 BOM 与传递依赖版本（技术选型见 docs/design/general/procurement-general.md §2.3） -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.gov</groupId>
    <artifactId>procurement</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>procurement</name>
    <description>采购与资产管理系统（首版：预算 → 审批 → 采购执行 → 领用/盘点）</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 非 Spring Boot BOM 管理的依赖，版本集中在此（技术选型见 docs/design/general/procurement-general.md §2.3） -->
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <sa-token.version>1.40.0</sa-token.version>
        <flowable.version>7.1.0</flowable.version>
        <fastexcel.version>1.1.0</fastexcel.version>
        <springdoc.version>2.7.0</springdoc.version>
    </properties>

    <dependencies>
        <!-- ===== Web / 校验 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ===== 数据库：PostgreSQL 驱动 + Flyway 迁移（版本由 Spring Boot BOM 管理）===== -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ===== 持久层：MyBatis-Plus（Spring Boot 3 starter）===== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
            <exclusions>
                <exclusion>
                    <artifactId>mybatis</artifactId>
                    <groupId>org.mybatis</groupId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- MyBatis-Plus 3.5.9 起，分页等依赖 JSqlParser 的插件拆到独立模块，须显式引入 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- mybatis-plus-core 把 MyBatis core 声明为 optional（不传递），显式补上以满足编译/运行 -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
            <version>3.5.16</version>
        </dependency>

        <!-- ===== 认证授权：Sa-Token（Spring Boot 3 starter）===== -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <!-- 仅用 BCryptPasswordEncoder 工具类，不引入整套 Security 过滤链（见 ADR-3） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- ===== 审批引擎：Flowable 嵌入式 BPMN（要求 Spring Boot 3 / Jakarta，见 ADR-4）===== -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter-process</artifactId>
            <version>${flowable.version}</version>
            <exclusions>
                <exclusion>
                    <artifactId>mybatis</artifactId>
                    <groupId>org.mybatis</groupId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ===== Excel 导入导出：FastExcel（EasyExcel 继任者，见 ADR-5）=====
             注：不可排除 commons-compress——POI 写 .xlsx（OOXML=ZIP）依赖它，缺失会在收尾时报「Can not close IO」。 -->
        <dependency>
            <groupId>cn.idev.excel</groupId>
            <artifactId>fastexcel</artifactId>
            <version>${fastexcel.version}</version>
        </dependency>
        <!-- 显式锁定 commons-compress 1.25.0：FastExcel 的 POI 5.2.5 需要 putArchiveEntry(ZipArchiveEntry)
             重载（1.25+），传递解析到的 1.24.0 缺该重载，写 .xlsx 时 NoSuchMethodError。直接声明=深度1，胜出仲裁。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.25.0</version>
        </dependency>

        <!-- ===== API 文档：springdoc-openapi + Swagger UI ===== -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ===== 测试：JUnit5 + MockMvc + Testcontainers(PostgreSQL)（版本由 BOM 管理）===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers 核心（版本由 Spring Boot BOM 管理，与 junit-jupiter 对齐）-->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- PostgreSQL 容器支持 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JdbcTemplate（HealthController 用；MyBatis-Plus 已传递引入，显式声明更清晰）-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- 显式声明 Spring 核心数据访问库（版本由 BOM 管理）：mybatis-spring/extension 编译期需要
             org.springframework.dao.DataAccessException(在 spring-tx)；这些本由 starter-jdbc 传递引入，
             显式声明以防 IDE 重导入或 exclusion 误删导致"找不到类文件"的编译错误。-->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
<!--                <configuration>-->
<!--                    <fork>false</fork>-->
<!--                </configuration>-->
            </plugin>
        </plugins>
    </build>
</project>
